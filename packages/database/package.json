{
  "name": "@ticketing/database",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema/index.d.mts",
        "default": "./dist/schema/index.mjs"
      },
      "require": {
        "types": "./dist/schema/index.d.cts",
        "default": "./dist/schema/index.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "db:generate": "XDG_DATA_HOME=${XDG_DATA_HOME:-/tmp} drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts",
    "db:studio": "XDG_DATA_HOME=${XDG_DATA_HOME:-/tmp} drizzle-kit studio"
  },
  "dependencies": {
    "@ticketing/common": "workspace:*",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.35.3",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^20.12.2",
    "drizzle-kit": "^0.26.2",
    "tsdown": "^0.23.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
